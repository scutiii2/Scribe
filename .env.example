# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
SCRIBE_HOST=127.0.0.1
SCRIBE_PORT=8091
# Measured on a 6-core CPU: small.en runs x0.5 real time, base.en x1.6. Armory cancels a call after 120 s,
# so raise the model and SCRIBE_MAX_SECONDS together, only after benchmarking (scripts/bench.py).
SCRIBE_MODEL=base.en
SCRIBE_MAX_SECONDS=150
SCRIBE_TIMEOUT_S=110
SCRIBE_TTL_HOURS=24
SCRIBE_QUOTA_MB=200
SCRIBE_CONCURRENCY=1
# Live dictation (WebSocket + HTTP previews): simultaneous streams, frame size, idle timeout, audio window.
SCRIBE_STREAM_CAPACITY=2
SCRIBE_STREAM_MAX_FRAME_BYTES=64000
SCRIBE_STREAM_IDLE_S=15
SCRIBE_STREAM_WINDOW_S=30
